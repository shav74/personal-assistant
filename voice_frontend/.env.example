# WS URL of the running WSL2 backend. WSL2 mirrored networking makes
# localhost from Windows reach the WSL2-hosted server directly.
BACKEND_WS_URL=ws://localhost:8000/ws/chat

# Picovoice Console -> AccessKey. Used for BOTH Porcupine (wake word)
# and Cobra (end-of-speech VAD) -- same account, same key.
PICOVOICE_ACCESS_KEY=

# Paths to your two trained .ppn wake-word files (Windows platform target,
# trained on the SPELLING "Neeve" / "hey Neeve", not "Niamh").
WAKE_KEYWORD_PATHS=models/neeve_windows.ppn,models/hey-neeve_windows.ppn
WAKE_KEYWORD_LABELS=neeve,hey neeve

# faster-whisper
WHISPER_MODEL_SIZE=base.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Piper TTS -- official prebuilt Windows binary + a downloaded .onnx voice
PIPER_EXE_PATH=C:\tools\piper\piper.exe
PIPER_VOICE_MODEL_PATH=C:\tools\piper\voices\en_US-lessac-medium.onnx

# Recording / end-of-speech tuning
SILENCE_HANGOVER_MS=800
VAD_VOICE_THRESHOLD=0.5
MAX_UTTERANCE_SECONDS=15
NO_SPEECH_TIMEOUT_SECONDS=4

# Optional sounddevice device overrides (blank = OS default)
INPUT_DEVICE=
OUTPUT_DEVICE=
